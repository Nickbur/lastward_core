# ── Lastward continuity core — environment ──────────────────────────────────
# Copy to `.env` and fill in. `docker compose` reads this file automatically.

# PostgreSQL connection string.
#   - docker compose (default): points at the bundled `db` service.
#   - running locally against your own Postgres: postgres://user:pass@localhost:5432/lastward
DATABASE_URL=postgres://lastward:lastward@db:5432/lastward

# The single owner's bearer token. Every /v1/switches* call must send
#   Authorization: Bearer <OWNER_TOKEN>
# Generate a strong one:  openssl rand -hex 32   (minimum 16 characters)
OWNER_TOKEN=change-me-generate-with-openssl-rand-hex-32

# Public base URL of this instance (no trailing slash). Used to build the release
# links in fire emails and the public-page URLs.
PUBLIC_URL=http://localhost:8080

# How often the in-process sweep runs, in seconds. 0 disables it (drive it from
# cron instead:  node dist/sweep.js). Keep it small — deadline resolution is minutes.
SWEEP_INTERVAL_SECONDS=60

# How long after firing encrypted payloads + release tokens are kept before the
# retention purge deletes them (also the release-link lifetime), in days.
FIRE_RETENTION_DAYS=90

# HTTP bind.
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without SMTP_HOST (or with EMAIL_DEV_MODE=true) email is printed to the console,
# so warnings + fire notifications work out of the box with no provider.
# Push and SMS are always console-only — the core ships no OneSignal/Twilio.

# Where owner check-in warning emails go. Unset ⇒ warnings are console-only.
OWNER_EMAIL=
# Force console output even if SMTP is configured.
EMAIL_DEV_MODE=false
# SMTP delivery (all optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Lastward <no-reply@lastward.local>
