{
    "name": "lastward-core",
    "version": "1.0.0",
    "license": "AGPL-3.0-only",
    "description": "Lastward continuity core — a minimal, self-contained, self-hostable server for a zero-knowledge digital dead man's switch. AGPL-3.0. Implements the same wire protocol as the Lastward cloud plus the self-host-only public_page action.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "db:generate": "npm run build && drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:migrate:prod": "node dist/db/migrate.js",
        "sweep": "tsx src/sweep.ts",
        "sweep:prod": "node dist/sweep.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/rate-limit": "^11.1.0",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.1",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.6.0",
        "nodemailer": "^7.0.6",
        "pg": "^8.16.3",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@types/node": "^22.13.0",
        "@types/nodemailer": "^7.0.2",
        "@types/pg": "^8.15.5",
        "drizzle-kit": "^0.31.4",
        "tsx": "^4.20.4",
        "typescript": "^5.9.2"
    }
}
