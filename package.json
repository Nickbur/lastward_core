{
    "name": "lastward-core",
    "version": "1.0.0",
    "license": "AGPL-3.0-only",
    "description": "Lastward continuity core — a minimal, self-contained, self-hostable server for a zero-knowledge digital dead man's switch. AGPL-3.0. Implements the same wire protocol as the Lastward cloud plus the self-host-only public_page action.",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "switch_to_dev": "node -e \"require('fs').copyFileSync('env/env.dev','.env')\"",
        "switch_to_prod": "node -e \"require('fs').copyFileSync('env/env.prod','.env')\"",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "db:generate": "npm run build && drizzle-kit generate",
        "postdb:generate": "node scripts/format-migrations.mjs && prettier --write drizzle --log-level warn",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:migrate:prod": "node dist/db/migrate.js",
        "sweep": "tsx src/sweep.ts",
        "sweep:prod": "node dist/sweep.js",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky || exit 0"
    },
    "dependencies": {
        "@fastify/cors": "11.3.0",
        "@fastify/rate-limit": "11.2.0",
        "date-fns": "4.4.0",
        "dotenv": "18.0.5",
        "drizzle-orm": "0.45.3",
        "fastify": "5.12.5",
        "nodemailer": "10.0.13",
        "pg": "8.23.1",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/node": "26.6.4",
        "@types/nodemailer": "8.0.2",
        "@types/pg": "8.23.1",
        "drizzle-kit": "0.31.11",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "prettier": "3.9.9",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown"
    }
}
