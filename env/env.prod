# Production config for a self-hosted Lastward continuity core.
# Same keys as env.dev — only values differ. Fill every REPLACE_ME_* before use.
DATABASE_URL=REPLACE_ME_database_url
OWNER_TOKEN=REPLACE_ME_owner_token
PUBLIC_URL=REPLACE_ME_public_url
SWEEP_INTERVAL_SECONDS=60
FIRE_RETENTION_DAYS=90
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
OWNER_EMAIL=REPLACE_ME_owner_email
EMAIL_DEV_MODE=false
SMTP_HOST=REPLACE_ME_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME_smtp_user
SMTP_PASS=REPLACE_ME_smtp_pass
MAIL_FROM=REPLACE_ME_mail_from
