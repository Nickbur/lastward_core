{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.webmanifest",
            "options": {
                "parser": "json"
            }
        },
        {
            "files": "*.vue",
            "options": {
                "singleAttributePerLine": true
            }
        }
    ]
}
